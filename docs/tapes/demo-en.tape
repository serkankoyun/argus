# Records the README demo and per-view screenshots (English).
Output docs/media/demo-en.gif

Set Shell "bash"
Set FontSize 14
Set Width 1600
Set Height 900
Set Padding 12
Set Theme "GitHub Dark"
Set TypingSpeed 80ms

Hide
Type "./target/release/argus --demo --lang en"
Enter
Sleep 4s
Show

Sleep 3s
Screenshot docs/media/overview-en.png
Type "5"
Sleep 5s
Screenshot docs/media/graph-en.png
Type "6"
Sleep 5s
Screenshot docs/media/room-en.png
Type "7"
Sleep 5s
Screenshot docs/media/lanes-en.png
Type "1"
Sleep 1s
Down
Type "3"
Sleep 3s
Screenshot docs/media/agent-en.png
Type "2"
Sleep 4s
Screenshot docs/media/sequence-en.png
Type "4"
Sleep 4s
Screenshot docs/media/fleet-en.png
Type "8"
Sleep 4s
Screenshot docs/media/channel-en.png
Type "9"
Sleep 4s
Screenshot docs/media/taskmap-en.png
Type "0"
Sleep 4s
Screenshot docs/media/pair-en.png
Type "t"
Sleep 2s
Down
Sleep 2s
Screenshot docs/media/teams-en.png
Enter
Sleep 3s
Screenshot docs/media/team-overview-en.png
Type "H"
Sleep 2s
Screenshot docs/media/history-en.png
Type "5"
Type "g"
Sleep 4s
Screenshot docs/media/graph-teams-en.png
Type "g"
Type "1"
Sleep 2s
Hide
Type "q"
