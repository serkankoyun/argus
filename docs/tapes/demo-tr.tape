# Records the README demo and per-view screenshots (Turkish).
Output docs/media/demo-tr.gif

Set Shell "bash"
Set FontSize 14
Set Width 1600
Set Height 900
Set Padding 12
Set Theme "GitHub Dark"
Set TypingSpeed 80ms

Hide
Type "./target/release/argus --demo --lang tr"
Enter
Sleep 4s
Show

Sleep 3s
Screenshot docs/media/overview-tr.png
Type "5"
Sleep 5s
Screenshot docs/media/graph-tr.png
Type "6"
Sleep 5s
Screenshot docs/media/room-tr.png
Type "7"
Sleep 5s
Screenshot docs/media/lanes-tr.png
Type "1"
Sleep 1s
Down
Type "3"
Sleep 3s
Screenshot docs/media/agent-tr.png
Type "2"
Sleep 4s
Screenshot docs/media/sequence-tr.png
Type "4"
Sleep 4s
Screenshot docs/media/fleet-tr.png
Type "8"
Sleep 4s
Screenshot docs/media/channel-tr.png
Type "9"
Sleep 4s
Screenshot docs/media/taskmap-tr.png
Type "0"
Sleep 4s
Screenshot docs/media/pair-tr.png
Type "t"
Sleep 2s
Down
Sleep 2s
Screenshot docs/media/teams-tr.png
Enter
Sleep 3s
Screenshot docs/media/team-overview-tr.png
Type "H"
Sleep 2s
Screenshot docs/media/history-tr.png
Type "5"
Type "g"
Sleep 4s
Screenshot docs/media/graph-teams-tr.png
Type "g"
Escape
Sleep 1s
Type "b"
Sleep 3s
Screenshot docs/media/queue-tr.png
Type "1"
Sleep 2s
Hide
Type "q"
